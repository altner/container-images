# syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b

# python: base + Python 3.13 (Interpreter und Standardbibliothek aus entpackten Debian-Paketen).
# Kein pip, keine Shell. Apps bringen ihr venv aus einem Build-Stage mit derselben Debian-Version mit.
ARG PARENT_IMAGE=ghcr.io/altner/images/base:13.7

FROM ${PARENT_IMAGE} AS parent

# Builder auf der Zielplattform. Python ist hier zusätzlich installiert (gleiche Version), um die
# Standardbibliothek vorzukompilieren.
FROM debian:13.7-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4 AS builder
ARG SOURCE_DATE_EPOCH
COPY --from=shared scripts/ /usr/local/lib/fabrik/
COPY --from=parent /var/lib/dpkg/status.d/ /parent-status/
# Bibliotheken, die die Module der Standardbibliothek per ldd brauchen und base nicht hat;
# libstdc++6 für C++-Wheels (die manylinux-Regeln setzen es beim System voraus);
# gcc-14-base liefert nur den Lizenztext von libstdc++6.
RUN /usr/local/lib/fabrik/extract-debs.sh /stage \
		gcc-14-base=14.2.0-19 \
		libbz2-1.0=1.0.8-6 \
		libexpat1=2.9.0-1~deb13u1 \
		libffi8=3.4.8-2 \
		liblzma5=5.8.1-1+deb13u2 \
		libpython3.13-minimal=3.13.5-2+deb13u5 \
		libpython3.13-stdlib=3.13.5-2+deb13u5 \
		libsqlite3-0=3.46.1-7+deb13u2 \
		libstdc++6=14.2.0-19 \
		libuuid1=2.41.5-0+deb13u1 \
		python3.13-minimal=3.13.5-2+deb13u5 \
	&& apt-get -qq install -y --no-install-recommends \
		python3.13-minimal=3.13.5-2+deb13u5 \
		libpython3.13-minimal=3.13.5-2+deb13u5 \
		libpython3.13-stdlib=3.13.5-2+deb13u5 >/dev/null

# Ohne die Module, deren Bibliothek fehlt: readline, curses (Terminal), dbm (Berkeley DB);
# ohne ensurepip (kein pip), idlelib, tkinter, turtledemo.
# Vorkompiliert mit Hash-Prüfung statt Zeitstempel: Die Zeitstempel normalisiert
# normalize-epoch.sh danach, und Python kann im schreibgeschützten Image nichts nachkompilieren.
RUN set -eu; \
	triplet=$(ls /stage/libexpat1/usr/lib | grep -- '-linux-gnu$'); \
	lib=usr/lib/$triplet; \
	py=usr/lib/python3.13; \
	mkdir -p /out; \
	cd /out; \
	mkdir -p usr/bin "$lib" etc usr/share/doc var/lib/dpkg/status.d; \
	cp -p /stage/python3.13-minimal/usr/bin/python3.13 usr/bin/python3.13; \
	ln -s python3.13 usr/bin/python3; \
	ln -s python3.13 usr/bin/python; \
	cp -a /stage/libpython3.13-minimal/usr/lib/python3.13 usr/lib/; \
	cp -a /stage/libpython3.13-stdlib/usr/lib/python3.13/. "$py/"; \
	cp -a /stage/libpython3.13-minimal/etc/python3.13 etc/; \
	rm -f "$py"/lib-dynload/readline.* "$py"/lib-dynload/_curses*.so "$py"/lib-dynload/_dbm.*; \
	rm -rf "$py"/ensurepip "$py"/idlelib "$py"/tkinter "$py"/turtledemo "$py"/test; \
	for pkg in libbz2-1.0 libexpat1 libffi8 liblzma5 libsqlite3-0 libstdc++6 libuuid1; do \
		find "/stage/$pkg/$lib" -maxdepth 1 -name '*.so*' ! -name 'libexpatw.so*' -exec cp -P {} "$lib/" \; ; \
	done; \
	python3.13 -m compileall -q -j0 --invalidation-mode unchecked-hash -s /out -p / "$py"; \
	for pkg in libbz2-1.0 libexpat1 libffi8 liblzma5 libpython3.13-minimal libpython3.13-stdlib \
		libsqlite3-0 libstdc++6 libuuid1 python3.13-minimal; do \
		doc=$pkg; [ ! -L "/stage/$pkg/usr/share/doc/$pkg" ] || doc=$(readlink "/stage/$pkg/usr/share/doc/$pkg"); \
		mkdir -p "usr/share/doc/$pkg"; \
		cp "/stage/$doc/usr/share/doc/$doc/copyright" "usr/share/doc/$pkg/copyright"; \
		cp "/stage/status.d/$pkg" "var/lib/dpkg/status.d/$pkg"; \
	done; \
	chown -R 0:0 /out; \
	find /out -type d -exec chmod 0755 {} +; \
	find /out -type f -exec chmod go-w,u-s,g-s {} +; \
	/usr/local/lib/fabrik/normalize-epoch.sh /out

FROM builder AS debug-builder
ARG SOURCE_DATE_EPOCH
RUN /usr/local/lib/fabrik/add-busybox.sh /debug

FROM ${PARENT_IMAGE} AS runtime
COPY --from=builder /out/ /
ENV PATH=/usr/local/bin:/usr/bin \
	LANG=C.UTF-8 \
	PYTHONDONTWRITEBYTECODE=1
CMD ["/usr/bin/python3"]

ARG VERSION
ARG REVISION
ARG PARENT_NAME
ARG PARENT_DIGEST
LABEL org.opencontainers.image.title="python" \
	org.opencontainers.image.description="base + Python ${VERSION} aus Debian 13.7" \
	org.opencontainers.image.version="${VERSION}" \
	org.opencontainers.image.revision="${REVISION}" \
	org.opencontainers.image.licenses="PSF-2.0 AND MIT AND bzip2-1.0.6 AND 0BSD AND BSD-3-Clause AND GPL-3.0-or-later WITH GCC-exception-3.1 AND LGPL-2.1-or-later AND GPL-2.0-or-later AND Apache-2.0 AND Zlib AND MPL-2.0 AND LicenseRef-public-domain" \
	org.opencontainers.image.base.name="${PARENT_NAME}" \
	org.opencontainers.image.base.digest="${PARENT_DIGEST}"

# -debug: zusätzlich busybox unter /busybox, nur für die lokale Fehlersuche.
FROM runtime AS debug
COPY --from=debug-builder /debug/ /
ENV PATH=/usr/local/bin:/usr/bin:/busybox
