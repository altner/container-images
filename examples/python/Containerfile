# syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b

# In eigenen App-Repos BASE_IMAGE per Digest pinnen:
#   FROM ghcr.io/altner/images/python:3.13.5@sha256:<digest>
ARG BASE_IMAGE=ghcr.io/altner/images/python:3.13.5

FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

# Build-Stage: Debian 13.7 mit demselben Python wie die Runtime (gleiche Paketversion aus dem
# Snapshot des Images), auf der Zielplattform, damit uv die passenden nativen Wheels wählt.
# Das venv zeigt auf /usr/bin/python3.13, den Interpreter der Runtime.
FROM debian:13.7-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS build
RUN sed -i -e 's|^# \(http://snapshot.debian.org/.*\)$|URIs: \1|' -e '/^URIs: http:\/\/deb.debian.org/d' \
		/etc/apt/sources.list.d/debian.sources \
	&& apt-get -qq -o Acquire::Check-Valid-Until=false update \
	&& apt-get -qq install -y --no-install-recommends \
		python3.13-minimal=3.13.5-2+deb13u5 \
		libpython3.13-minimal=3.13.5-2+deb13u5 \
		libpython3.13-stdlib=3.13.5-2+deb13u5 >/dev/null
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
	UV_PYTHON_DOWNLOADS=never \
	UV_COMPILE_BYTECODE=1 \
	UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --python /usr/bin/python3.13
COPY app.py index.html ./

FROM ${BASE_IMAGE}
COPY --from=build /opt/venv /opt/venv
COPY --from=build /app /app
WORKDIR /app
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --start-interval=1s CMD ["/opt/venv/bin/python", "/app/app.py", "healthcheck"]
CMD ["/opt/venv/bin/python", "/app/app.py"]
