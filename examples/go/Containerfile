# syntax=docker/dockerfile:1.29.0@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183

# In eigenen App-Repos BASE_IMAGE per Digest pinnen:
#   FROM ghcr.io/altner/images/static:13.7@sha256:<digest>
ARG BASE_IMAGE=ghcr.io/altner/images/static:13.7

# Go cross-kompiliert, daher läuft der Build-Stage nativ auf der Build-Plattform.
FROM --platform=$BUILDPLATFORM golang:1.27.3-trixie@sha256:fbb7ae40b62ff8afe31662df570d39b4f5052ac32b90dae8e60d7657a20a74f4 AS build
ARG TARGETOS
ARG TARGETARCH
ARG SOURCE_DATE_EPOCH
WORKDIR /src
COPY go.mod ./
COPY *.go ./
COPY static/ static/
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
	go build -trimpath -buildvcs=false -ldflags="-s -w -buildid=" -o /out/app . \
	&& touch -d "@${SOURCE_DATE_EPOCH:-0}" /out/app

FROM ${BASE_IMAGE}
COPY --from=build /out/app /app
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --start-interval=1s CMD ["/app", "healthcheck"]
ENTRYPOINT ["/app"]
